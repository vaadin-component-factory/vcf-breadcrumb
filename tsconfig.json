{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "lib": ["es2017", "dom"],
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "outDir": "dist",
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./",
    "declaration": false,
    "incremental": true,
    "tsBuildInfoFile": "./.tmp/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["**/*.ts"],
  "exclude": ["types", "dist", "node_modules"]
}
